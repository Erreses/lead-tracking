# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database — your leads live here, never commit it
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build scratch: Google's photos and the raw Places payload the agent reads.
# Never committed — that data is Google's, not ours. `generated-sites/` holds
# only the pages we wrote, and those ARE committed so the deployed app can
# serve them to whoever is using it.
/.site-work
