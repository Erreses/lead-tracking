# Keep the build context small and, more importantly, keep secrets and local
# data out of the image entirely.
.git
.github
node_modules
.next
data
*.log

# Never bake credentials into an image. Coolify injects these at runtime.
.env
.env.*
!.env.example

.claude
coverage

# Reference photos and Places payloads. The generated pages themselves are
# deliberately NOT ignored — they are copied into the image and served.
.site-work
*.tsbuildinfo
README.md
DEPLOY.md
