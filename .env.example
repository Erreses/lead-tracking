# Copy this file to .env.local and fill in the values.
#
# On the VPS these are set in Coolify's environment editor instead, and
# DATABASE_URL is wired up for you by docker-compose.yml.

# ---------------------------------------------------------------- database
# Postgres connection string. Required — the app cannot start without it.
#   local:  postgres://you@localhost:5432/lead_tracking
#   Docker: postgres://lead_tracking:lead_tracking@localhost:5432/lead_tracking
DATABASE_URL=postgres://localhost:5432/lead_tracking

# TLS to the database: `require`, `disable`, or leave unset to decide by host
# (plaintext for localhost, opportunistic TLS for anything remote).
# DATABASE_SSL=

# ------------------------------------------------------------------- access
# Shared password for the deployed dashboard. Leave EMPTY locally — with no
# password set, `npm run dev` skips the login screen entirely.
#
# In production the app refuses to serve without it, so a public URL can never
# end up unprotected by accident. Generate one with:
#   openssl rand -base64 24
APP_ACCESS_PASSWORD=

# ------------------------------------------------------------------ scraping
# Google Maps Places API key. Required to run a scrape; the dashboard works
# without one (you can still price a sweep and browse existing leads).
#
# To create one:
#   1. https://console.cloud.google.com/  →  create a project
#   2. Enable the "Places API (New)" for that project
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. Enable billing on the project. This is required even to use the free
#      monthly allowance; you are not charged until you exceed it.
#   5. Restrict the key to the Places API (New) so a leaked key can't be
#      used against other Google services.
GOOGLE_MAPS_API_KEY=

# -------------------------------------------------------------------- misc
# debug | info | warn | error. Defaults to info.
# LOG_LEVEL=info

# How many pre-scrape snapshots to keep. Defaults to 3.
# MAX_BACKUPS=3
