# Copy this file to .env.local and fill in your key.
#
# Google Maps Places API key. Required to run a scrape; the dashboard works
# without one (you can still price a sweep and browse existing leads).
#
# To create one:
#   1. https://console.cloud.google.com/  →  create a project
#   2. Enable the "Places API (New)" for that project
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. Enable billing on the project. This is required even to use the free
#      monthly allowance; you are not charged until you exceed it.
#   5. Restrict the key to the Places API (New) so a leaked key can't be
#      used against other Google services.
GOOGLE_MAPS_API_KEY=

# Optional: where the SQLite file lives. Defaults to ./data/leads.db
# DATABASE_PATH=./data/leads.db
